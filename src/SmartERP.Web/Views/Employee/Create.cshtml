@using Microsoft.AspNetCore.Mvc.Rendering

@model EmployeeCreateViewModel;
@{
    ViewData["Title"] = "Create employee";
    var genders = (IEnumerable<SelectListItem>)ViewData["Genders"]!;
    var departments = (IEnumerable<SelectListItem>)ViewData["Departments"]!;
    var employmentTypes = (IEnumerable<SelectListItem>)ViewData["EmploymentTypes"]!;
    var employmentStatuses = (IEnumerable<SelectListItem>)ViewData["EmploymentStatuses"]!;
    var positions = (IEnumerable<SelectListItem>)ViewData["Positions"]!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Employee" asp-action="Index">Back to register</a>

    <div class="register-header mb-3">
        <h1 class="register-title">Create employee</h1>
        <p class="register-subtitle mb-1">One person, their contact details, and optionally their first assignment.</p>
        <p class="register-meta mb-0">Written @DateTime.Today.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="register-panel register-form">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="register-errors" role="alert"></div>

            <div class="field">
                <label asp-for="FirstName"></label>
                <input asp-for="FirstName" type="text" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="LastName"></label>
                <input asp-for="LastName" type="text" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="text" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Phone"></label>
                <input asp-for="Phone" type="text" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="DateOfBirth"></label>
                <input asp-for="DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="GenderId"></label>
                <select asp-for="GenderId" asp-items="genders" class="form-select">
                    <option value="">Select gender</option>
                </select>
                <span asp-validation-for="GenderId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Address"></label>
                <input asp-for="Address" type="text" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="check-row">
                <input asp-for="IncludeEmploymentDetails" type="checkbox" />
                <label asp-for="IncludeEmploymentDetails">Include a first assignment</label>
            </div>

            <div id="detailsSection" style="display:none">
                <fieldset>
                    <legend>First assignment</legend>

                    <div class="field">
                        <label asp-for="PositionId"></label>
                        <select asp-for="PositionId" asp-items="positions" class="form-select">
                            <option value="">Select position</option>
                        </select>
                        <span asp-validation-for="PositionId" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Salary"></label>
                        <input asp-for="Salary" type="number" step="100" min="0" class="form-control" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="StartDate"></label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="DepartmentId"></label>
                        <select asp-for="DepartmentId" asp-items="departments" class="form-select">
                            <option value="">Select department</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="EmploymentTypeId"></label>
                        <select asp-for="EmploymentTypeId" asp-items="employmentTypes" class="form-select">
                            <option value="">Select type</option>
                        </select>
                        <span asp-validation-for="EmploymentTypeId" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="EmploymentStatusId"></label>
                        <select asp-for="EmploymentStatusId" asp-items="employmentStatuses" class="form-select">
                            <option value="">Select status</option>
                        </select>
                        <span asp-validation-for="EmploymentStatusId" class="text-danger"></span>
                    </div>
                </fieldset>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-register">Create employee</button>
                <a asp-action="Index" class="btn btn-stamp">Back to register</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Show the employment details section only when the checkbox is on;
        // server-side IValidatableObject enforces the same rule on submit.
        // The input's id is generated by asp-for as IncludeEmploymentDetails,
        // matching the label, so the pair always toggles.
        (function () {
            var toggle = document.getElementById('IncludeEmploymentDetails');
            var section = document.getElementById('detailsSection');
            function sync() { section.style.display = toggle.checked ? '' : 'none'; }
            toggle.addEventListener('change', sync);
            sync();
        })();
    </script>
}
