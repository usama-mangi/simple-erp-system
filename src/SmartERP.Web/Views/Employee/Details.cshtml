@using SmartERP.Data.Models

@model Employee;

<div>
    <dl>
        <dt>First Name</dt>
        <dd>@Model.FirstName</dd>

        <dt>Last Name</dt>
        <dd>@Model.LastName</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Phone</dt>
        <dd>@Model.Phone</dd>

        <dt>Date of Birth</dt>
        <dd>@Model.DateOfBirth</dd>

        <dt>Gender</dt>
        <dd>@((Gender)Model.GenderId)</dd>

        <dt>Address</dt>
        <dd>@Model.Address</dd>

        <dt>Last Updated</dt>
        <dd>
            @if (Model.UpdatedAt == default)
            {
                <span>Never Updated</span>
            }
            else
            {
                <span>@Model.UpdatedAt.ToString("dd-mm-yyyy")</span>
            }
        </dd>
    </dl>
</div>