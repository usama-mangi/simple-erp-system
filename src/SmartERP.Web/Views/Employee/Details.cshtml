@using SmartERP.Data.Models
@using SmartERP.Web.Models

@model EmployeeDetailsViewModel;

@functions {
    private static string Title(Dictionary<decimal, string>? titles, decimal id)
        => titles is not null && titles.TryGetValue(id, out var title) ? title : "Unknown";
}

@{
    ViewData["Title"] = $"Employee register - {Model.Employee.FirstName} {Model.Employee.LastName}";
    var genderTitles = ViewData["GenderTitles"] as Dictionary<decimal, string>;
    var updatedMeta = Model.Employee.UpdatedAt == default
        ? "NOT UPDATED YET"
        : $"UPDATED {Model.Employee.UpdatedAt:yyyy-MM-dd}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Employee" asp-action="Index">Back to register</a>

    <div class="register-header d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
            <h1 class="register-title">@Model.Employee.FirstName @Model.Employee.LastName</h1>
            <p class="register-meta mb-0">RECORD #@Model.Employee.Id &middot; @updatedMeta</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert decision-seal mb-3" role="status">
            <span class="seal-word">Recorded</span>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="register-panel">
        <dl class="record-sheet">
            <dt>Employee ID</dt>
            <dd>@Model.Employee.Id</dd>

            <dt>Email</dt>
            <dd>@Model.Employee.Email</dd>

            <dt>Phone</dt>
            <dd>@Model.Employee.Phone</dd>

            <dt>Date of birth</dt>
            <dd><span class="register-dates">@Model.Employee.DateOfBirth.ToString("yyyy-MM-dd")</span></dd>

            <dt>Gender</dt>
            <dd>@Title(genderTitles, Model.Employee.GenderId)</dd>

            <dt>Address</dt>
            <dd>@Model.Employee.Address</dd>
        </dl>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-3">
        <a asp-controller="Employee" asp-action="Update" asp-route-id="@Model.Employee.Id" class="btn btn-register">Update</a>
        <a asp-controller="Employee" asp-action="Delete" asp-route-id="@Model.Employee.Id" class="btn btn-stamp btn-stamp--reject">Delete</a>
    </div>

    <h2>Employment history</h2>

    @{
        // The partial owns the table plus the "Add job" / "change department" zone.
        ViewData["ShowActions"] = true;
    }
    <partial name="_EmploymentHistory" model="Model.History" />

    <h2>Status history</h2>

    <div class="register-panel register-panel--scroll">
        @if (!Model.StatusEvents.Any())
        {
            <p class="register-empty">No status changes recorded yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="register-table">
                    <caption class="visually-hidden">Status changes for this employee, oldest first.</caption>
                    <thead>
                        <tr>
                            <th scope="col">When</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ev in Model.StatusEvents)
                        {
                            <tr>
                                <td class="register-dates">@ev.ChangedAt.ToString("yyyy-MM-dd")</td>
                                <td>@(ev.FromStatusTitle ?? "First status")</td>
                                <td>@ev.ToStatusTitle</td>
                                <td>@(string.IsNullOrWhiteSpace(ev.Note) ? "—" : ev.Note)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <p class="mt-3 mb-0">
        <a asp-controller="Leave" asp-action="Index" asp-route-employeeId="@Model.Employee.Id"
           class="register-link">Leave requests for this employee</a>
    </p>
    <p class="mt-2 mb-0">
        <a asp-controller="Documents" asp-action="Index" asp-route-employeeId="@Model.Employee.Id"
           class="register-link">Documents for this employee</a>
    </p>
</div>
