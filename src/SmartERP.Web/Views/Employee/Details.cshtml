@using SmartERP.Data.Models

@model EmployeeWithDetails;

@functions {
    private static string Title(Dictionary<double, string>? titles, double id)
        => titles is not null && titles.TryGetValue(id, out var title) ? title : "Unknown";
}

@{
    var genderTitles = ViewData["GenderTitles"] as Dictionary<double, string>;
    var departmentTitles = ViewData["DepartmentTitles"] as Dictionary<double, string>;
    var employmentTypeTitles = ViewData["EmploymentTypeTitles"] as Dictionary<double, string>;
    var employmentStatusTitles = ViewData["EmploymentStatusTitles"] as Dictionary<double, string>;
}

<div>
    <dl>
        <dt>Employee ID</dt>
        <dd>@Model.Id</dd>

        <dt>First Name</dt>
        <dd>@Model.FirstName</dd>

        <dt>Last Name</dt>
        <dd>@Model.LastName</dd>

        <dt>Email</dt>
        <dd>@Model.Email</dd>

        <dt>Phone</dt>
        <dd>@Model.Phone</dd>

        <dt>Date of Birth</dt>
        <dd>@Model.DateOfBirth.ToShortDateString()</dd>

        <dt>Gender</dt>
        <dd>@Title(genderTitles, Model.GenderId)</dd>

        <dt>Address</dt>
        <dd>@Model.Address</dd>

        @if (Model.HasEmploymentDetails)
        {
            <dt>Job Title</dt>
            <dd>@Model.JobTitle</dd>

            <dt>Salary</dt>
            <dd>@Model.Salary.ToString("N")</dd>

            <dt>Department</dt>
            <dd>@Title(departmentTitles, Model.DepartmentId)</dd>

            <dt>Employment Type</dt>
            <dd>@Title(employmentTypeTitles, Model.EmploymentTypeId)</dd>

            <dt>Employment Status</dt>
            <dd>@Title(employmentStatusTitles, Model.EmploymentStatusId)</dd>

            <dt>Start Date</dt>
            <dd>@Model.StartDate.ToShortDateString()</dd>

            <dt>End Date</dt>
            <dd>
                @if (Model.EndDate is null)
                {
                    <span>Current employment</span>
                }
                else
                {
                    <span>@Model.EndDate.Value.ToShortDateString()</span>
                }
            </dd>
        }

        <dt>Last Updated</dt>
        <dd>
            @if (Model.UpdatedAt == default)
            {
                <span>Never Updated</span>
            }
            else
            {
                <span>@Model.UpdatedAt.ToString("dd MMM yyyy")</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-controller="Employee" asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning">Update</a>
    <a asp-controller="Employee" asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
    <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
