@using SmartERP.Data.Models;
@using SmartERP.Web

@model IEnumerable<Employee>;

@functions {
    private static string Title(Dictionary<double, string>? titles, double id)
        => titles is not null && titles.TryGetValue(id, out var title) ? title : "Unknown";
}

@{
    var genderTitles = ViewData["GenderTitles"] as Dictionary<double, string>;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employees</h2>
    <a asp-controller="Employee" asp-action="Create" class="btn btn-primary">Create New Employee</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th scope="col">First Name</th>
                <th scope="col">Last Name</th>
                <th scope="col">Email</th>
                <th scope="col">Phone</th>
                <th scope="col">Date of Birth</th>
                <th scope="col">Gender</th>
                <th scope="col">Address</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.FirstName</td>
                    <td>@emp.LastName</td>
                    <td>@emp.Email</td>
                    <td>@emp.Phone</td>
                    <td>@emp.DateOfBirth.ToShortDateString()</td>
                    <td>@Title(genderTitles, emp.GenderId)</td>
                    <td>@emp.Address</td>
                    <td>
                        <a asp-controller="Employee" asp-action="Details" asp-route-id="@emp.Id">Show Details</a> |
                        <a asp-controller="Employment" asp-action="Index" asp-route-employeeId="@emp.Id">Jobs</a> |
                        <a asp-controller="Employee" asp-action="Update" asp-route-id="@emp.Id">Update</a> |
                        <a asp-controller="Employee" asp-action="Delete" asp-route-id="@emp.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
