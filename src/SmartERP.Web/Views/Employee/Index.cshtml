@using SmartERP.Data.Models;

@model IEnumerable<Employee>;

@functions {
    private static string Title(Dictionary<decimal, string>? titles, decimal id)
        => titles is not null && titles.TryGetValue(id, out var title) ? title : "Unknown";
}

@{
    ViewData["Title"] = "Employee register";
    var genderTitles = ViewData["GenderTitles"] as Dictionary<decimal, string>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <div class="register-header d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
            <h1 class="register-title">Employee register</h1>
            <p class="register-subtitle mb-1">Everyone on the books, with their current contact details.</p>
            <p class="register-meta mb-0">Read @DateTime.Today.ToString("yyyy-MM-dd")</p>
        </div>
        <div>
            <a asp-controller="Employee" asp-action="Create" class="btn btn-register">Create employee</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert decision-seal mb-3" role="status">
            <span class="seal-word">Recorded</span>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="register-panel register-panel--scroll">
        @if (!Model.Any())
        {
            <p class="register-empty">No employees on the register yet.
                <a asp-controller="Employee" asp-action="Create" class="register-link">Create the first one</a>
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="register-table">
                    <caption class="visually-hidden">Everyone on the employee register, with current contact details.
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Phone</th>
                            <th scope="col">Date of birth</th>
                            <th scope="col">Gender</th>
                            <th scope="col">Address</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in Model)
                        {
                            <tr>
                                <td class="register-employee">
                                    <a asp-controller="Employee" asp-action="Details" asp-route-id="@emp.Id"
                                       class="register-link">@emp.FirstName @emp.LastName</a>
                                </td>
                                <td>@emp.Email</td>
                                <td>@emp.Phone</td>
                                <td class="register-dates">@emp.DateOfBirth.ToString("yyyy-MM-dd")</td>
                                <td>@Title(genderTitles, emp.GenderId)</td>
                                <td>@emp.Address</td>
                                <td>
                                    <div class="register-actions">
                                        <a asp-controller="Employment" asp-action="Index" asp-route-employeeId="@emp.Id"
                                           class="btn btn-stamp">Jobs</a>
                                        <a asp-controller="Employee" asp-action="Update" asp-route-id="@emp.Id"
                                           class="btn btn-stamp">Update</a>
                                        <a asp-controller="Employee" asp-action="Delete" asp-route-id="@emp.Id"
                                           class="btn btn-stamp btn-stamp--reject">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
