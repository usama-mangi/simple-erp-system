@using SmartERP.Web.Models

@model DepartmentManagerIndexViewModel;

<div class="register-panel register-panel--scroll">
    @if (!Model.Managers.Any())
    {
        <p class="register-empty">No manager assignments on the record yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="register-table">
                <caption class="visually-hidden">Management history for @Model.Department.Name, most recent first.</caption>
                <thead>
                    <tr>
                        <th scope="col">Manager</th>
                        <th scope="col">Start</th>
                        <th scope="col">End</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.Managers)
                    {
                        <tr>
                            <td>@assignment.ManagerName</td>
                            <td class="register-dates">@assignment.StartDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                @if (assignment.EndDate is null)
                                {
                                    <span class="stamp stamp--current">Current</span>
                                }
                                else
                                {
                                    <span class="register-dates">@assignment.EndDate.Value.ToString("yyyy-MM-dd")</span>
                                }
                            </td>
                            <td>
                                @if (assignment.EndDate is null)
                                {
                                    <form asp-controller="DepartmentManagers" asp-action="Close" method="post"
                                          class="d-flex align-items-center gap-2">
                                        <label class="visually-hidden" for="close-date-@assignment.Id">End date</label>
                                        <input id="close-date-@assignment.Id" type="date" name="EndDate" required
                                               class="form-control" />
                                        <button type="submit" class="btn btn-stamp">Close</button>
                                        <input type="hidden" name="DepartmentId" value="@Model.Department.Id" />
                                    </form>
                                }
                                else
                                {
                                    <span class="register-reason">Closed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
