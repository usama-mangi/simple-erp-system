@using SmartERP.Web.Models

@model DepartmentDetailsViewModel;

@{
    ViewData["Title"] = $"Department register - {Model.Department.Name}";
    var updatedMeta = Model.Department.UpdatedAt == default
        ? "NOT UPDATED YET"
        : $"UPDATED {Model.Department.UpdatedAt:yyyy-MM-dd}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Department" asp-action="Index">Back to register</a>

    <div class="register-header d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
            <h1 class="register-title">@Model.Department.Name</h1>
            <p class="register-meta mb-0">RECORD #@Model.Department.Id &middot; @updatedMeta</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert decision-seal mb-3" role="status">
            <span class="seal-word">Recorded</span>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="register-panel">
        <dl class="record-sheet">
            <dt>Department code</dt>
            <dd>@Model.Department.Code</dd>

            <dt>Location</dt>
            <dd>@Model.Department.Location</dd>

            <dt>Established</dt>
            <dd><span class="register-dates">@Model.Department.Established.ToString("yyyy-MM-dd")</span></dd>

            <dt>Reports to</dt>
            <dd>
                @if (Model.Department.ParentDepartmentId is { } parentId)
                {
                    <a asp-controller="Department" asp-action="Details" asp-route-id="@parentId"
                       class="register-link">@Model.Department.ParentName</a>
                }
                else
                {
                    <span>Top-level department</span>
                }
            </dd>

            <dt>Open headcount</dt>
            <dd>@Model.DirectHeadcount</dd>

            <dt>Including sub-departments</dt>
            <dd>@Model.RollupHeadcount</dd>
        </dl>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-3">
        <a asp-controller="Department" asp-action="Update" asp-route-id="@Model.Department.Id" class="btn btn-register">Update</a>
        <a asp-controller="Department" asp-action="Delete" asp-route-id="@Model.Department.Id" class="btn btn-stamp btn-stamp--reject">Delete</a>
    </div>

    <h2>Departments reporting here</h2>

    @if (!Model.Children.Any())
    {
        <p class="register-empty">No department reports here.</p>
    }
    else
    {
        <div class="register-panel register-panel--scroll">
            <div class="table-responsive">
                <table class="register-table">
                    <caption class="visually-hidden">Departments that report to @Model.Department.Name.</caption>
                    <thead>
                        <tr>
                            <th scope="col">Code</th>
                            <th scope="col">Department</th>
                            <th scope="col">Open headcount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in Model.Children)
                        {
                            <tr>
                                <th scope="row">@child.Code</th>
                                <td>
                                    <a asp-controller="Department" asp-action="Details" asp-route-id="@child.Id"
                                       class="register-link">@child.Name</a>
                                </td>
                                <td>@child.DirectHeadcount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <h2>Management</h2>

    <div class="register-panel">
        @if (!Model.ManagerOptions.Any())
        {
            <p class="register-empty">No employees with an open assignment are available to manage this department yet.</p>
        }
        else
        {
            <form asp-controller="DepartmentManagers" asp-action="Assign" method="post"
                  class="register-filter"
                  onsubmit="return confirm('This ends the current manager assignment, if any, and starts the new one today. Continue?');">
                <label for="manager-select">Manager</label>
                <select id="manager-select" name="ManagerId" required asp-items="Model.ManagerOptions"
                        class="form-select">
                    <option value="">Select manager</option>
                </select>
                <button type="submit" class="btn btn-register">Assign</button>
                <input type="hidden" name="DepartmentId" value="@Model.Department.Id" />
            </form>
        }
    </div>

    <partial name="_DepartmentManagerHistory"
             model="new DepartmentManagerIndexViewModel { Department = Model.Department, Managers = Model.Managers }" />
</div>
