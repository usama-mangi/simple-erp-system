@using SmartERP.Web.Models

@model DepartmentDetailsViewModel;

@{
    ViewData["Title"] = $"Department - {Model.Department.Name}";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2>Department Details</h2>

<div>
    <dl>
        <dt>Department Code</dt>
        <dd>@Model.Department.Code</dd>

        <dt>Name</dt>
        <dd>@Model.Department.Name</dd>

        <dt>Location</dt>
        <dd>@Model.Department.Location</dd>

        <dt>Established</dt>
        <dd>@Model.Department.Established.ToString("dd MMM yyyy")</dd>

        <dt>Last Updated</dt>
        <dd>
            @if (Model.Department.UpdatedAt == default)
            {
                <span>Never Updated</span>
            }
            else
            {
                <span>@Model.Department.UpdatedAt.ToString("dd MMM yyyy")</span>
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-controller="Department" asp-action="Update" asp-route-id="@Model.Department.Id" class="btn btn-warning">Update</a>
    <a asp-controller="Department" asp-action="Delete" asp-route-id="@Model.Department.Id" class="btn btn-danger">Delete</a>
    <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>

<h3 class="mt-4">Management</h3>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Assign Manager</h5>

        @if (!Model.ManagerOptions.Any())
        {
            <p class="text-muted mb-0">No employees with an open assignment are available to manage this department yet.</p>
        }
        else
        {
            <form asp-controller="DepartmentManagers" asp-action="Assign" method="post"
                  class="d-flex flex-wrap align-items-center gap-2"
                  onsubmit="return confirm('This ends the current manager assignment (if any) and starts the new one today. Continue?');">
                <select name="ManagerId" required asp-items="Model.ManagerOptions"
                        class="form-select" style="width: auto;">
                    <option value="">Select manager</option>
                </select>
                <button type="submit" class="btn btn-primary">Assign</button>
                <input type="hidden" name="DepartmentId" value="@Model.Department.Id" />
            </form>
        }
    </div>
</div>

<partial name="_DepartmentManagerHistory"
         model="new DepartmentManagerIndexViewModel { Department = Model.Department, Managers = Model.Managers }" />

<div class="mt-3">
    <a asp-controller="DepartmentManagers" asp-action="Index" asp-route-departmentId="@Model.Department.Id"
       class="btn btn-outline-secondary">Full Manage Page</a>
    <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Back to Departments</a>
</div>
