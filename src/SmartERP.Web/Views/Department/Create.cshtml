@model DepartmentCreateViewModel;
@{
    ViewData["Title"] = "Create department";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Department" asp-action="Index">Back to register</a>

    <div class="register-header mb-3">
        <h1 class="register-title">Create department</h1>
        <p class="register-subtitle mb-1">A new node in the reporting tree.</p>
        <p class="register-meta mb-0">Written @DateTime.Today.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="register-panel register-form">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="register-errors" role="alert"></div>

            <div class="field">
                <label asp-for="Name"></label>
                <input asp-for="Name" type="text" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Code"></label>
                <input asp-for="Code" type="text" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Location"></label>
                <input asp-for="Location" type="text" class="form-control" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Established"></label>
                <input asp-for="Established" type="date" class="form-control" />
                <span asp-validation-for="Established" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="ParentDepartmentId">Reports to</label>
                <select asp-for="ParentDepartmentId" asp-items="Model.ParentOptions" class="form-select">
                    <option value="">No parent (top level)</option>
                </select>
                <p class="form-text mb-0">Leave blank for a top-level department.</p>
                <span asp-validation-for="ParentDepartmentId" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-register">Create department</button>
                <a asp-action="Index" class="btn btn-stamp">Back to register</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
