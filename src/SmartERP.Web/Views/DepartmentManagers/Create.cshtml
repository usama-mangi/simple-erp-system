@using Microsoft.AspNetCore.Mvc.Rendering

@model DepartmentManagerCreateViewModel;
@{
    ViewData["Title"] = "Assign Manager";
    var managers = (IEnumerable<SelectListItem>)ViewData["Managers"]!;
}

<h2>Assign Manager</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="DepartmentId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ManagerId" class="control-label"></label>
                <select asp-for="ManagerId" asp-items="managers" class="form-select">
                    <option value="">Select employee</option>
                </select>
                <span asp-validation-for="ManagerId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartDate" class="control-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndDate" class="control-label"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-primary">Assign Manager</button>
                <a asp-action="Index" asp-route-departmentId="@Model.DepartmentId"
                   class="btn btn-secondary">Back to History</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
