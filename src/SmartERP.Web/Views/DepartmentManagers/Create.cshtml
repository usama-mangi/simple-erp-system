@using Microsoft.AspNetCore.Mvc.Rendering

@model DepartmentManagerCreateViewModel;
@{
    ViewData["Title"] = "Assign manager";
    var managers = (IEnumerable<SelectListItem>)ViewData["Managers"]!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="DepartmentManagers" asp-action="Index" asp-route-departmentId="@Model.DepartmentId">Back to managers</a>

    <div class="register-header mb-3">
        <h1 class="register-title">Assign manager</h1>
        <p class="register-subtitle mb-1">One dated mandate per department. Close the current row before filing a new one.</p>
        <p class="register-meta mb-0">Written @DateTime.Today.ToString("yyyy-MM-dd")</p>
    </div>

    <div class="register-panel register-form">
        <form asp-action="Create" method="post">
            <input type="hidden" asp-for="DepartmentId" />

            <div asp-validation-summary="ModelOnly" class="register-errors" role="alert"></div>

            <div class="field">
                <label asp-for="ManagerId"></label>
                <select asp-for="ManagerId" asp-items="managers" class="form-select">
                    <option value="">Select employee</option>
                </select>
                <span asp-validation-for="ManagerId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-register">Assign manager</button>
                <a asp-action="Index" asp-route-departmentId="@Model.DepartmentId"
                   class="btn btn-stamp">Back to managers</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
