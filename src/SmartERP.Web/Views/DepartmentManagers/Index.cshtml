@using SmartERP.Web.Models

@model DepartmentManagerIndexViewModel;

@{
    ViewData["Title"] = $"Managers of {Model.Department.Name}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Department" asp-action="Index">Back to register</a>

    <div class="register-header d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
            <h1 class="register-title">Managers of @Model.Department.Name</h1>
            <p class="register-subtitle mb-1">Every assignment for @Model.Department.Name (@Model.Department.Code), the open row is the current manager.</p>
            <p class="register-meta mb-0">RECORD #@Model.Department.Id</p>
        </div>
        <div>
            <a asp-controller="DepartmentManagers" asp-action="Create" asp-route-departmentId="@Model.Department.Id"
               class="btn btn-register">Assign manager</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert decision-seal mb-3" role="status">
            <span class="seal-word">Recorded</span>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <partial name="_DepartmentManagerHistory" model="Model" />
</div>
