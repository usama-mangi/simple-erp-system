@using SmartERP.Web.Models

@model DepartmentManagerIndexViewModel;

@{
    ViewData["Title"] = $"Managers of {Model.Department.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Managers of @Model.Department.Name (@Model.Department.Code)</h2>
    <a asp-controller="DepartmentManagers" asp-action="Create" asp-route-departmentId="@Model.Department.Id"
       class="btn btn-primary">Assign Manager</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<partial name="_DepartmentManagerHistory" model="Model" />

<div>
    <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">Back to Departments</a>
</div>
