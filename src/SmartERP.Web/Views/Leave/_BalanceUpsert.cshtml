@using Microsoft.AspNetCore.Mvc.Rendering
@using SmartERP.Web.Models

@model LeaveBalanceUpsertViewModel

@{
    // The partial's model is the upsert VM itself, so asp-for renders
    // "EmployeeId" rather than "Upsert.EmployeeId" and the action binds
    // without a prefix.
    var leaveTypeOptions = (IEnumerable<SelectListItem>?)ViewData["LeaveTypeOptions"]
                           ?? Enumerable.Empty<SelectListItem>();
}

<div class="register-panel register-form">
    <h2 class="h5 mb-3">Set an entitlement</h2>

    <form asp-action="UpsertBalance" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <input type="hidden" asp-for="EmployeeId" />
        <input type="hidden" asp-for="Year" />

        <div class="field">
            <label asp-for="LeaveTypeId" class="control-label"></label>
            <select asp-for="LeaveTypeId" asp-items="leaveTypeOptions" class="form-select">
                <option value="">Select leave type</option>
            </select>
            <span asp-validation-for="LeaveTypeId" class="text-danger"></span>
        </div>

        <div class="field">
            <label asp-for="EntitlementDays" class="control-label"></label>
            <input asp-for="EntitlementDays" type="number" step="0.5" min="0" class="form-control" />
            <span asp-validation-for="EntitlementDays" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" class="btn btn-register">Save entitlement</button>
            <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-stamp">Back to register</a>
        </div>
    </form>
</div>
