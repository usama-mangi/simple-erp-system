@using Microsoft.AspNetCore.Mvc.Rendering

@model DocumentViewModel;
@{
    ViewData["Title"] = "Add document";
    var employeeName = ViewData["EmployeeName"] as string;
    var types = (IEnumerable<SelectListItem>)ViewData["DocumentTypes"]!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Documents" asp-action="Index" asp-route-employeeId="@Model.EmployeeId">Back to documents</a>

    <div class="register-header mb-3">
        <h1 class="register-title">Add document</h1>
        @if (!string.IsNullOrEmpty(employeeName))
        {
            <p class="register-subtitle mb-1">Metadata for @employeeName's document. The files themselves are not stored here.</p>
        }
        <p class="register-meta mb-0">EMPLOYEE #@Model.EmployeeId</p>
    </div>

    <div class="register-panel register-form">
        <form asp-controller="Documents" asp-action="Create" method="post">
            <input type="hidden" asp-for="EmployeeId" />

            <div asp-validation-summary="ModelOnly" class="register-errors" role="alert"></div>

            <div class="field">
                <label asp-for="TypeId">Type</label>
                <select asp-for="TypeId" asp-items="types" class="form-select">
                    <option value="">Select type</option>
                </select>
                <span asp-validation-for="TypeId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Title"></label>
                <input asp-for="Title" type="text" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="IssuedOn"></label>
                <input asp-for="IssuedOn" type="date" class="form-control" />
                <span asp-validation-for="IssuedOn" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="ExpiresAt"></label>
                <input asp-for="ExpiresAt" type="date" class="form-control" />
                <span asp-validation-for="ExpiresAt" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Note"></label>
                <input asp-for="Note" type="text" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-register">Add document</button>
                <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId" class="btn btn-stamp">Back to documents</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
