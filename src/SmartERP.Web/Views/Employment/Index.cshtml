@using SmartERP.Web.Models

@model EmploymentIndexViewModel;

@{
    ViewData["Title"] = $"Employment history - {Model.Employee.FirstName} {Model.Employee.LastName}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Employee" asp-action="Details" asp-route-id="@Model.Employee.Id">Back to employee</a>

    <div class="register-header d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
            <h1 class="register-title">Employment history</h1>
            <p class="register-subtitle mb-1">@Model.Employee.FirstName @Model.Employee.LastName, every assignment, the open row is the current one.</p>
            <p class="register-meta mb-0">RECORD #@Model.Employee.Id</p>
        </div>
        <div>
            <a asp-controller="Employment" asp-action="Create" asp-route-employeeId="@Model.Employee.Id"
               class="btn btn-register">New assignment</a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert decision-seal mb-3" role="status">
            <span class="seal-word">Recorded</span>
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <partial name="_EmploymentHistory" model="Model" />
</div>
