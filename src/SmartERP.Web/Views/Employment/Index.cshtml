@using SmartERP.Web.Models

@model EmploymentIndexViewModel;

@{
    ViewData["Title"] = $"Employment History - {Model.Employee.FirstName} {Model.Employee.LastName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Employment History: @Model.Employee.FirstName @Model.Employee.LastName</h2>
    <a asp-controller="Employment" asp-action="Create" asp-route-employeeId="@Model.Employee.Id"
       class="btn btn-primary">New Assignment</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Success!</strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<partial name="_EmploymentHistory" model="Model" />

<div>
    <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">Back to Employees</a>
</div>
