@using Microsoft.AspNetCore.Mvc.Rendering

@model EmploymentDetailCreateViewModel;
@{
    ViewData["Title"] = "New assignment";
    var departments = (IEnumerable<SelectListItem>)ViewData["Departments"]!;
    var employmentTypes = (IEnumerable<SelectListItem>)ViewData["EmploymentTypes"]!;
    var employmentStatuses = (IEnumerable<SelectListItem>)ViewData["EmploymentStatuses"]!;
    var positions = (IEnumerable<SelectListItem>)ViewData["Positions"]!;
}

@section Styles {
    <link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
}

<div class="register-surface">
    <a class="register-back" asp-controller="Employment" asp-action="Index" asp-route-employeeId="@Model.EmployeeId">Back to employment history</a>

    <div class="register-header mb-3">
        <h1 class="register-title">New assignment</h1>
        <p class="register-subtitle mb-1">Position, pay and dates. If an assignment is open, this start date ends it.</p>
        <p class="register-meta mb-0">Written @DateTime.Today.ToString("yyyy-MM-dd")</p>
    </div>

    @if ((bool)(ViewData["HasOpenAssignment"] ?? false))
    {
        <div class="alert register-warn mb-3" role="alert">
            <span class="warn-word">Open assignment</span>
            This employee has an open assignment. Creating this record ends that assignment on the
            start date you pick below.
        </div>
    }

    <div class="register-panel register-form">
        <form asp-action="Create" method="post" id="createForm">
            <input type="hidden" asp-for="EmployeeId" />

            <div asp-validation-summary="ModelOnly" class="register-errors" role="alert"></div>

            <div class="field">
                <label asp-for="PositionId"></label>
                <select asp-for="PositionId" asp-items="positions" class="form-select">
                    <option value="">Select position</option>
                </select>
                <span asp-validation-for="PositionId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="Salary"></label>
                <input asp-for="Salary" type="number" step="100" min="0" class="form-control" />
                <span asp-validation-for="Salary" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" type="date" class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="DepartmentId"></label>
                <select asp-for="DepartmentId" asp-items="departments" class="form-select">
                    <option value="">Select department</option>
                </select>
                <span asp-validation-for="DepartmentId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="EmploymentTypeId"></label>
                <select asp-for="EmploymentTypeId" asp-items="employmentTypes" class="form-select">
                    <option value="">Select type</option>
                </select>
                <span asp-validation-for="EmploymentTypeId" class="text-danger"></span>
            </div>

            <div class="field">
                <label asp-for="EmploymentStatusId"></label>
                <select asp-for="EmploymentStatusId" asp-items="employmentStatuses" class="form-select">
                    <option value="">Select status</option>
                </select>
                <span asp-validation-for="EmploymentStatusId" class="text-danger"></span>
            </div>

            @if ((bool)(ViewData["HasOpenAssignment"] ?? false))
            {
                <div class="check-row">
                    <input type="checkbox" asp-for="ConfirmReplace" id="replaceToggle" />
                    <label for="replaceToggle">
                        I understand the current assignment will end on the start date above and the new record takes its place.
                    </label>
                </div>
                <span asp-validation-for="ConfirmReplace" class="text-danger d-block mb-3"></span>
            }

            <div class="d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-register">Create assignment</button>
                <a asp-action="Index" asp-route-employeeId="@Model.EmployeeId"
                   class="btn btn-stamp">Back to history</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var form = document.getElementById('createForm');
            var toggle = document.getElementById('replaceToggle');
            if (!form || !toggle) return;

            var startDate = document.querySelector('input[name="StartDate"]');

            form.addEventListener('submit', function (event) {
                if (!toggle.checked) return;

                var message = 'The current assignment will be ended'
                    + (startDate && startDate.value ? ' on ' + startDate.value : '')
                    + ' and replaced by the new record. Continue?';

                if (!window.confirm(message)) event.preventDefault();
            });
        })();
    </script>
}
